# Database
DATABASE_URL=postgresql+psycopg://ks:ks@localhost:5432/kaushalsetu
READONLY_DATABASE_URL=postgresql+psycopg://ks_readonly:ks_readonly@localhost:5432/kaushalsetu

# API Keys (Gov Data)
OGD_API_KEY=
NDAP_API_KEY=

# LLM Configuration
LLM_PROVIDER=google
LLM_FAST_MODEL=gemini-2.5-flash
LLM_STRONG_MODEL=gemini-2.5-pro
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Embeddings
EMBEDDINGS_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-m3

# Observability (Optional)
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Application Controls
DEMO_MODE=true
RUN_TOKEN_BUDGET=400000
COVERAGE_STALE_DAYS=14
AUTO_ACCEPT=0.75
REVIEW_MIN=0.45
ADMIN_PASSWORD=change-in-production

# App Server
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
LOG_LEVEL=INFO
